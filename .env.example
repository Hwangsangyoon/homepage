# Real values go in Netlify > Environment variables (Functions scope).
# Never upload an actual .env or your password to GitHub.
# Required ONCE for first login: choose your own 12-128 character password,
# containing ASCII letters and numbers, with no whitespace.
OPTIC_ADMIN_PASSWORD=

# Optional: real SMS/Kakao sending, unrelated to administrator login.
# Without these settings test records still work and NO paid send occurs.
MESSAGING_ENABLED=false
# SOLAPI_API_KEY=
# SOLAPI_API_SECRET=
# SOLAPI_SENDER=
# SOLAPI_KAKAO_PFID=

# RESEND_API_KEY / OPTIC_ADMIN_EMAIL / OPTIC_SETUP_KEY / SUPABASE_* not used.
